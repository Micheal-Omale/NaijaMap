	"summary": {
		"text": "The Hausa are Nigeria’s largest people, numbering around 86 million across West Africa, based in the savanna of northern Nigeria and southern Niger. Their historic city-states, among them Kano, Katsina, Zazzau (Zaria), Daura and Gobir, became emirates of the Sokoto Caliphate. Hausa is the main language of the north and a language of trade far beyond it.",
		"sources": [
			"wikipedia-hausa-people",
			"wikipedia-hausa-kingdoms",
			"amfani-2018"
		],
		"confidence": "high"
	},
