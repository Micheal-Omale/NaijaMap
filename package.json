{
  "name": "niajmap",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:preview": "astro build --mode preview",
    "preview": "astro preview",
    "check": "astro check",
    "geo": "node scripts/build-geo.mjs",
    "astro": "astro",
    "geo:region": "node scripts/build-region.mjs",
    "film": "remotion studio src/index.ts",
    "film:render": "remotion render src/index.ts BeforeTheLines out/before-the-lines.raw.mp4 --codec=h264 --crf=17 --audio-codec=aac --audio-bitrate=256k && node scripts/loudnorm.mjs out/before-the-lines.raw.mp4 out/before-the-lines.mp4"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@remotion/cli": "^4.0.534",
    "@remotion/google-fonts": "^4.0.534",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "maplibre-gl": "^6.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.534",
    "zod": "4.5.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mapshaper": "^0.7.76",
    "typescript": "^6.0.3"
  }
